// Пример с рамками. =Название= открывает рамку, == закрывает её.
// Внутри рамки у блоков своя «область»: «Показать ошибку» ниже — два разных блока.
// =Рамка= [Блок] — блок из другой рамки, == (Блок) — общий блок вне рамок.

(Старт) -> =Авторизация= [Ввод пароля]

=Авторизация=
[Ввод пароля] -> {Пароль верный?}
{Пароль верный?} -> [Показать ошибку] "Нет" -> [Ввод пароля]
{Пароль верный?} -> =Загрузка= [Открыть профиль] "Да"

=Загрузка=
[Открыть профиль] -> [Загрузить настройки] -> {Всё загрузилось?}
{Всё загрузилось?} -> [Показать ошибку] "Нет" -> == (Конец)
{Всё загрузилось?} -> == (Конец) "Да"
