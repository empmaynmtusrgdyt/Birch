// Exemple avec cadres. =Nom= ouvre un cadre, == le ferme.
// Les blocs d'un cadre lui sont propres : les deux « Afficher l'erreur » ci-dessous sont des blocs différents.
// =Cadre= [Bloc] est un bloc d'un autre cadre, == (Bloc) un bloc commun hors des cadres.

(Début) -> =Connexion= [Saisir le mot de passe]

=Connexion=
[Saisir le mot de passe] -> {Mot de passe correct ?}
{Mot de passe correct ?} -> [Afficher l'erreur] "Non" -> [Saisir le mot de passe]
{Mot de passe correct ?} -> =Chargement= [Ouvrir le profil] "Oui"

=Chargement=
[Ouvrir le profil] -> [Charger les paramètres] -> {Tout est chargé ?}
{Tout est chargé ?} -> [Afficher l'erreur] "Non" -> == (Fin)
{Tout est chargé ?} -> == (Fin) "Oui"
